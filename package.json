{
  "name": "chartex",
  "version": "2.0.0",
  "description": "A data visualization library for the terminal using ASCII characters.",
  "type": "module",
  "homepage": "https://metalbolicx.github.io/chartex/",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "module": "./dist/index.mjs",
  "main": "dist/main.mjs",
  "bin": {
    "chartex": "bin/ChartexCli.res.mjs"
  },
  "types": "dist/index.d.mts",
  "scripts": {
    "docs": "docsify serve docs",
    "start": "node dist/main.mjs",
    "build": "tsdown",
    "res:build": "rescript",
    "res:dev": "rescript watch",
    "res:clean": "rescript clean",
    "res:test": "retest ./test/res/*.res.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "bundle": "rolldown -c",
    "cli:build": "npm run res:build && npm run bundle"
  },
  "author": {
    "name": "José Martínez Santana"
  },
  "keywords": [
    "terminal",
    "data-visualization",
    "ascii",
    "charting",
    "cli",
    "javascript",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MetalbolicX/chartex.git"
  },
  "bugs": {
    "url": "https://github.com/MetalbolicX/chartex/issues"
  },
  "files": [
    "dist",
    "bin"
  ],
  "license": "MIT",
  "devDependencies": {
    "rescript-test": "^8.0.1",
    "rolldown": "1.2.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@rescript/runtime": "^12.3.0",
    "rescript": "^12.3.0"
  }
}
